# Build trees (CMake presets put everything under build/)
/build/
/compile_commands.json

# Editor and tool caches
/.cache/
/.vscode/
/.idea/
*.swp

# Python tooling
__pycache__/
*.pyc
.venv/

# Local, private notes for Claude Code (names, paths); never commit.
/CLAUDE.local.md

# CI compiler cache
.ccache/

# Reference documents fetched by tools/ (not ours to redistribute in git)
docs/reference/

# Terrain source downloads (tools/fetch-sources.py); the lock files are committed
data/cache/

# Synthetic databases the terrain tests write (they use the temp directory; this guards old runs)
terrain_test_dbs/
